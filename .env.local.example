# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_IMG_URL=http://localhost:8000

# WebSocket Configuration
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_WSS_URL=wss://your-production-domain.com/ws

# WebSocket Feature Flag (set to 'false' to disable WebSocket in development)
NEXT_PUBLIC_ENABLE_WEBSOCKET=false

# LiveKit Configuration (for video calls)
NEXT_PUBLIC_LIVEKIT_URL=wss://zhancare-4yvomh3h.livekit.cloud

# Optional: Deepgram API for transcription
NEXT_PUBLIC_DEEPGRAM_API_KEY=your_deepgram_api_key_here
