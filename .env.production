# Production Configuration

# API Configuration
NEXT_PUBLIC_API_URL=https://api.zhan.care/api/v1
NEXT_PUBLIC_API_IMG_URL=https://api.zhan.care

# WebSocket - Production
NEXT_PUBLIC_ENABLE_WEBSOCKET=true
NEXT_PUBLIC_WS_URL=ws://api.zhan.care/ws
NEXT_PUBLIC_WSS_URL=wss://api.zhan.care/ws

# LiveKit for video calls
NEXT_PUBLIC_LIVEKIT_URL=wss://zhancare-4yvomh3h.livekit.cloud

# TipTop Pay — Public ID only
NEXT_PUBLIC_TIPTOP_PUBLIC_ID=pk_0fafe9c5414eea658d494b1eb6ef3

# Cloudflare Turnstile — public site key (blank disables the widget).
# Backend needs the matching CLOUDFLARE_TURNSTILE_SECRET set too, or
# send-code endpoints won't actually enforce it either.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
